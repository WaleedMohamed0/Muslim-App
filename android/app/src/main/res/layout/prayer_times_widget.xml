<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_times_widget_background"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_widget_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:gravity="start"
            android:maxLines="1"
            android:text="مواقيت الصلاة"
            android:textColor="@color/prayer_widget_primary_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
                android:id="@+id/prayer_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text="موقعك الحالي"
                android:textColor="@color/prayer_widget_secondary_text"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/prayer_widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/prayer_widget_secondary_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/prayer_widget_upcoming_background"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prayer_widget_countdown_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:maxLines="1"
                android:text="الصلاة القادمة"
                android:textColor="@color/prayer_widget_secondary_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/prayer_widget_next_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/prayer_widget_primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/prayer_widget_remaining_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="start"
                android:maxLines="1"
                android:text="الوقت المتبقي للأذان"
                android:textColor="@color/prayer_widget_secondary_text"
                android:textSize="11sp" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/prayer_widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:format="%s"
            android:layout_marginTop="2dp"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/prayer_widget_primary_text"
            android:textDirection="ltr"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/prayer_cell_fajr" style="@style/PrayerWidgetCell">
                <TextView android:id="@+id/prayer_name_fajr" style="@style/PrayerWidgetCellName" android:text="الفجر" />
                <TextView android:id="@+id/prayer_time_fajr" style="@style/PrayerWidgetCellTime" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_cell_sunrise" style="@style/PrayerWidgetCell">
                <TextView android:id="@+id/prayer_name_sunrise" style="@style/PrayerWidgetCellName" android:text="الشروق" />
                <TextView android:id="@+id/prayer_time_sunrise" style="@style/PrayerWidgetCellTime" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_cell_dhuhr" style="@style/PrayerWidgetCell">
                <TextView android:id="@+id/prayer_name_dhuhr" style="@style/PrayerWidgetCellName" android:text="الظهر" />
                <TextView android:id="@+id/prayer_time_dhuhr" style="@style/PrayerWidgetCellTime" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/prayer_cell_asr" style="@style/PrayerWidgetCell">
                <TextView android:id="@+id/prayer_name_asr" style="@style/PrayerWidgetCellName" android:text="العصر" />
                <TextView android:id="@+id/prayer_time_asr" style="@style/PrayerWidgetCellTime" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_cell_maghrib" style="@style/PrayerWidgetCell">
                <TextView android:id="@+id/prayer_name_maghrib" style="@style/PrayerWidgetCellName" android:text="المغرب" />
                <TextView android:id="@+id/prayer_time_maghrib" style="@style/PrayerWidgetCellTime" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_cell_isha" style="@style/PrayerWidgetCell">
                <TextView android:id="@+id/prayer_name_isha" style="@style/PrayerWidgetCellName" android:text="العشاء" />
                <TextView android:id="@+id/prayer_time_isha" style="@style/PrayerWidgetCellTime" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
