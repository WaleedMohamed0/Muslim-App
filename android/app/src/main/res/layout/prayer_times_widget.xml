<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_times_widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header rows are laid out left-to-right so each item stays on its intended side. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center_vertical|left" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/prayer_widget_moon_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/prayer_widget_moon" />
            <TextView android:id="@+id/prayer_widget_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:gravity="start" android:maxLines="1" android:textColor="@color/prayer_widget_primary_text" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center_vertical|start" android:layoutDirection="rtl" android:orientation="horizontal">
            <ImageView android:id="@+id/prayer_widget_calendar_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/prayer_widget_calendar" />
            <TextView android:id="@+id/prayer_widget_gregorian" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:ellipsize="end" android:gravity="start" android:maxLines="1" android:textColor="@color/prayer_widget_secondary_text" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center_vertical|left" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/prayer_widget_clock_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="6dp" android:src="@drawable/prayer_widget_clock" />
            <Chronometer android:id="@+id/prayer_widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:format="%s" android:gravity="left|center_vertical" android:includeFontPadding="false" android:textAlignment="viewStart" android:textColor="@color/prayer_widget_primary_text" android:textDirection="ltr" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="بعد" android:textColor="@color/prayer_widget_primary_text" android:textSize="12sp" />
            <TextView android:id="@+id/prayer_widget_next_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/prayer_widget_primary_text" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center_vertical|end" android:layoutDirection="rtl" android:orientation="horizontal">
            <ImageView android:id="@+id/prayer_widget_location_icon" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/prayer_widget_location" />
            <TextView android:id="@+id/prayer_widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:gravity="right|center_vertical" android:textAlignment="gravity" android:maxLines="2" android:textDirection="rtl" android:breakStrategy="simple" android:textColor="@color/prayer_widget_secondary_text" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:importantForAccessibility="no"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="4dp"
        android:background="@color/prayer_widget_border"
        android:text="" />

    <LinearLayout
        android:id="@+id/prayer_widget_times"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.55"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/prayer_cell_fajr" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_fajr" style="@style/PrayerWidgetCellName" android:text="الفجر" />
            <TextView android:id="@+id/prayer_time_fajr" style="@style/PrayerWidgetCellTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_cell_dhuhr" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_dhuhr" style="@style/PrayerWidgetCellName" android:text="الظهر" />
            <TextView android:id="@+id/prayer_time_dhuhr" style="@style/PrayerWidgetCellTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_cell_asr" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_asr" style="@style/PrayerWidgetCellName" android:text="العصر" />
            <TextView android:id="@+id/prayer_time_asr" style="@style/PrayerWidgetCellTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_cell_maghrib" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_maghrib" style="@style/PrayerWidgetCellName" android:text="المغرب" />
            <TextView android:id="@+id/prayer_time_maghrib" style="@style/PrayerWidgetCellTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_cell_isha" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_isha" style="@style/PrayerWidgetCellName" android:text="العشاء" />
            <TextView android:id="@+id/prayer_time_isha" style="@style/PrayerWidgetCellTime" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
