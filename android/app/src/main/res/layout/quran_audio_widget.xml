<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quran_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quran_audio_widget_background"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="0dp"
    android:paddingEnd="12dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/quran_widget_main_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="7dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:id="@+id/quran_widget_header"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
            android:id="@+id/quran_widget_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/quran_audio_widget_avatar_background"
            android:clipToOutline="true"
            android:contentDescription="صورة القارئ"
            android:scaleType="centerCrop"
            android:src="@drawable/quran_audio_widget_avatar_fallback" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quran_widget_surah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:gravity="start"
                android:maxLines="1"
                android:text="الْقُرْآن الكريم"
                android:textColor="@color/quran_widget_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quran_widget_reciter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="اختر قارئك المفضل"
                android:textColor="@color/quran_widget_secondary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/quran_widget_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="لا توجد تلاوة نشطة"
                android:textColor="@color/quran_widget_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="true" />
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quran_widget_timeline"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/quran_widget_elapsed"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:textDirection="ltr"
            android:text="0:00"
            android:textColor="@color/quran_widget_secondary_text"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/quran_widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="@color/quran_widget_progress_track"
            android:progressTint="@color/quran_widget_accent" />

        <TextView
            android:id="@+id/quran_widget_remaining"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:textDirection="ltr"
            android:text="-0:00"
            android:textColor="@color/quran_widget_secondary_text"
            android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/quran_widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/quran_audio_widget_button"
            android:contentDescription="السُّورَة التالية"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/quran_widget_next" />

        <ImageButton
            android:id="@+id/quran_widget_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/quran_audio_widget_primary_button"
            android:contentDescription="تشغيل التلاوة"
            android:elevation="2dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/quran_widget_play" />

        <ImageButton
            android:id="@+id/quran_widget_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/quran_audio_widget_button"
            android:contentDescription="السُّورَة السابقة"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/quran_widget_previous" />

    </LinearLayout>
</LinearLayout>
